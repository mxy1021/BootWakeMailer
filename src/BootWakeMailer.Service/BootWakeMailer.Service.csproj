<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows Service host (architecture.md §3.2). Owns event capture, the durable
    queue and the 60-second retry loop.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BootWakeMailer.Service</RootNamespace>
    <AssemblyName>BootWakeMailer.Service</AssemblyName>
    <!-- Self-contained win-x64 is the deployment model (requirements.md §2). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsService>true</UseWindowsService>
  </PropertyGroup>

  <ItemGroup>
    <!-- ServiceBase and PowerBroadcastStatus. Not part of the base framework. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BootWakeMailer.Shared\BootWakeMailer.Shared.csproj" />
  </ItemGroup>

</Project>
